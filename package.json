{
  "name": "web-ide",
  "version": "0.1.0",
  "private": true,
  "description": "Embeddable browser IDE workbench with open host, runtime, and plugin contracts.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins.d.ts",
      "import": "./dist/plugins.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    },
    "./runtimes": {
      "types": "./dist/runtimes.d.ts",
      "import": "./dist/runtimes.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./language-tools": {
      "types": "./dist/language-tools.d.ts",
      "import": "./dist/language-tools.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "npm run build:library && npm --workspace @web-ide/basic-example run dev",
    "build": "npm run build:library && npm run build:example && npm run build:plugin-demo",
    "build:library": "vite build",
    "build:example": "npm --workspace @web-ide/basic-example run build",
    "build:plugin-demo": "npm --workspace @web-ide/plugin-demo run build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run --exclude \"tests/browser/**\"",
    "test:watch": "vitest --exclude \"tests/browser/**\"",
    "test:browser": "playwright test",
    "test:browser:headed": "playwright test --headed",
    "test:consumer": "npm pack --pack-destination . --silent && node tests/consumer/run-packed-consumer.mjs",
    "pack:check": "npm pack --dry-run",
    "validate": "npm run lint && npm run test && npm run typecheck && npm run build && npm run test:consumer && npm run pack:check",
    "validate:production": "npm run validate && npm run test:browser"
  },
  "workspaces": [
    "examples/basic",
    "examples/plugin-demo"
  ],
  "packageManager": "npm@11.6.2",
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "dependencies": {
    "debugger-sh": "0.3.15"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@eslint/js": "^9.39.1",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.2.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vscode/codicons": "^0.0.45",
    "@vitejs/plugin-react": "^5.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.13",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "lucide-react": "^0.575.0",
    "material-icon-theme": "^5.34.0",
    "memfs": "^4.56.10",
    "monaco-editor": "^0.56.0",
    "buffer": "6.0.3",
    "events": "3.3.0",
    "path-browserify": "1.0.1",
    "process": "0.11.10",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "^4.6.4",
    "stream-browserify": "3.0.0",
    "tailwindcss": "^4.2.0",
    "tailwind-merge": "^3.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^4.1.6",
    "zustand": "^5.0.11"
  },
  "overrides": {
    "dompurify": "^3.4.13",
    "uuid": "^11.1.1"
  }
}
