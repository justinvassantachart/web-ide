              "size": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "fileName",
              "size",
              "sha256"
            ],
            "properties": {
              "kind": {
                "const": "deterministic-builds"
              },
              "fileName": {
                "const": "deterministic-builds.json"
