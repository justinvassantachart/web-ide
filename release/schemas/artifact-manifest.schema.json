                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "fileName",
              "size",
              "sha256"
            ],
            "properties": {
              "kind": {
                "const": "runtime-assets"
              },
              "fileName": {
                "const": "runtime-assets-verification.json"
              },
              "size": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
