        },
        "expectedRedirectCount": {
          "const": 0
        },
        "requestTimeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assets": {
          "type": "array",
          "minItems": 27,
          "maxItems": 27,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version",
              "requestedUrl",
              "finalUrl",
              "size",
              "sha256",
              "contentType",
              "headers",
              "license"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "requestedUrl": {
                "type": "string",
                "pattern": "^https://"
              },
              "finalUrl": {
                "type": "string",
                "pattern": "^https://"
              },
              "size": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "contentType": {
                "type": "string",
                "minLength": 1
              },
              "headers": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "access-control-allow-origin",
                  "cross-origin-resource-policy"
                ],
                "properties": {
                  "access-control-allow-origin": {
                    "type": "string"
                  },
                  "cross-origin-resource-policy": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              "license": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "debuggerSh": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "registry",
            "source",
            "distribution"
          ],
          "properties": {
            "registry": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "version",
                "resolved",
                "integrity"
              ],
              "properties": {
                "name": {
                  "const": "debugger-sh"
                },
                "version": {
                  "const": "0.3.15"
                },
                "resolved": {
                  "const": "https://registry.npmjs.org/debugger-sh/-/debugger-sh-0.3.15.tgz"
                },
                "integrity": {
                  "const": "sha512-Sx4B8RPU5t5Pj50vFs7ngLvOr1YLwF9xsqdF/p2vbLRA38gv8iJ06EmPmuVfXoFFyI0fo+7kVe6tQRYwTC8lNA=="
                }
              }
            },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repository",
                "tag",
                "commit"
              ],
              "properties": {
                "repository": {
                  "const": "https://github.com/debugger-sh/engine"
                },
                "tag": {
                  "const": "v0.3.15"
                },
                "commit": {
                  "const": "cc250508fabb5b091075e073ceb2e14899fd8423"
                }
              }
            },
            "distribution": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "size",
                "sha256"
              ],
              "properties": {
                "path": {
                  "const": "dist/engine_bg.wasm"
                },
                "size": {
                  "const": 8760773
                },
                "sha256": {
                  "const": "65379e4e786195233151269f7cd7f55dc3891dcd0725f5eee048d70de39b959b"
                }
              }
            }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateSha256",
        "gateCount",
        "logCount"
      ],
      "properties": {
        "candidateSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "gateCount": {
          "const": 5
        },
        "logCount": {
          "const": 5
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "fileName",
              "size",
              "sha256"
            ],
            "properties": {
              "kind": {
