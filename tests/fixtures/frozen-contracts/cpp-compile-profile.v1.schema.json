{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cs106b.local/schemas/cpp-compile-profile.v1.schema.json",
  "title": "CppCompileProfileV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "target", "languageStandard", "includeDirectories", "defines", "warningPreset", "toolchain"],
  "properties": {
    "version": { "const": 1 },
    "target": { "const": "wasm32-wasip1" },
    "languageStandard": { "enum": ["c++11", "c++14", "c++17", "c++20", "c++23"] },
    "includeDirectories": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/vfsPath" }
    },
    "defines": {
      "type": "array",
      "maxItems": 128,
      "x-uniqueBy": "name",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]{0,127}$" },
          "value": { "type": "string", "maxLength": 1024 }
        }
      }
    },
    "warningPreset": { "enum": ["default", "strict"] },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compilerDigest", "sysrootDigest", "cxxAbiId"],
      "properties": {
        "compilerDigest": { "$ref": "#/$defs/sha256" },
        "sysrootDigest": { "$ref": "#/$defs/sha256" },
        "cxxAbiId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "vfsPath": { "type": "string", "minLength": 2, "maxLength": 1024, "pattern": "^/(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\u0000\\uD800-\\uDFFF\\\\]+$" }
  }
}
