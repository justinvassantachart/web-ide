{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cs106b.local/schemas/workspace-transaction.v1.schema.json",
  "title": "WorkspaceTransactionV1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "kind", "transactionId", "expectedRevision", "origin", "operations"],
      "properties": {
        "version": { "const": 1 },
        "kind": { "const": "apply" },
        "transactionId": { "$ref": "#/$defs/id" },
        "expectedRevision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "origin": { "$ref": "#/$defs/origin" },
        "operations": { "$ref": "#/$defs/operations" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "kind", "revision", "transactionId", "origin", "operations"],
      "properties": {
        "version": { "const": 1 },
        "kind": { "const": "change" },
        "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "transactionId": { "$ref": "#/$defs/id" },
        "origin": { "$ref": "#/$defs/origin" },
        "operations": { "$ref": "#/$defs/operations" }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "path": { "type": "string", "minLength": 2, "maxLength": 1024, "pattern": "^/workspace(?:/(?!\\.{1,2}(?:/|$))[^/\\u0000\\uD800-\\uDFFF\\\\]+)+$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source"],
      "properties": {
        "kind": { "enum": ["local-user", "external-authority", "bootstrap", "restore", "provider"] },
        "source": { "$ref": "#/$defs/id" },
        "echoToken": { "$ref": "#/$defs/id" }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "oneOf": [
          { "type": "object", "additionalProperties": false, "required": ["op", "path", "text"], "properties": { "op": { "const": "write" }, "path": { "$ref": "#/$defs/path" }, "text": { "type": "string", "maxLength": 2097152 }, "expectedSha256": { "$ref": "#/$defs/sha256" } } },
          { "type": "object", "additionalProperties": false, "required": ["op", "path", "text"], "properties": { "op": { "const": "create" }, "path": { "$ref": "#/$defs/path" }, "text": { "type": "string", "maxLength": 2097152 } } },
          { "type": "object", "additionalProperties": false, "required": ["op", "path"], "properties": { "op": { "const": "delete" }, "path": { "$ref": "#/$defs/path" }, "expectedSha256": { "$ref": "#/$defs/sha256" } } },
          { "type": "object", "additionalProperties": false, "required": ["op", "from", "to"], "properties": { "op": { "const": "rename" }, "from": { "$ref": "#/$defs/path" }, "to": { "$ref": "#/$defs/path" }, "expectedSha256": { "$ref": "#/$defs/sha256" } } },
          { "type": "object", "additionalProperties": false, "required": ["op", "files"], "properties": { "op": { "const": "replace" }, "files": { "type": "object", "maxProperties": 500, "propertyNames": { "$ref": "#/$defs/path" }, "additionalProperties": { "type": "string", "maxLength": 2097152 } } } }
        ]
      }
    }
  }
}
