{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cs106b.local/schemas/testing-v2.schema.json",
  "title": "TestingV2Envelope",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "workspaceDigest", "catalogDigest", "tests"],
      "properties": {
        "apiVersion": { "const": 2 },
        "kind": { "const": "catalog" },
        "workspaceDigest": { "$ref": "#/$defs/sha256" },
        "catalogDigest": { "$ref": "#/$defs/sha256" },
        "tests": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/descriptor" } }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "mode", "workspaceDigest", "catalogDigest", "selection"],
      "properties": {
        "apiVersion": { "const": 2 },
        "kind": { "const": "run_request" },
        "mode": { "enum": ["run", "debug"] },
        "workspaceDigest": { "$ref": "#/$defs/sha256" },
        "catalogDigest": { "$ref": "#/$defs/sha256" },
        "selection": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "all" } } },
            { "type": "object", "additionalProperties": false, "required": ["kind", "testIds"], "properties": { "kind": { "const": "tests" }, "testIds": { "type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": { "$ref": "#/$defs/testId" } } } }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "runId", "sequence", "event"],
      "properties": {
        "apiVersion": { "const": 2 },
        "kind": { "const": "report_event" },
        "runId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
        "sequence": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "event": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "enum": ["run_started", "test_started", "test_passed", "test_failed", "test_skipped", "test_errored", "output", "run_finished", "run_terminated"] },
            "testId": { "$ref": "#/$defs/testId" },
            "durationMs": { "type": "number", "minimum": 0 },
            "message": { "type": "string", "maxLength": 65536 },
            "path": { "$ref": "#/$defs/path" },
            "line": { "type": "integer", "minimum": 1 },
            "column": { "type": "integer", "minimum": 1 },
            "reason": { "enum": ["completed", "stopped", "timeout", "output_limit", "memory_limit", "protocol_violation", "runtime_crash", "build_failed", "selection_stale"] }
          },
          "allOf": [
            {
              "if": { "properties": { "type": { "enum": ["test_started", "test_passed", "test_failed", "test_skipped", "test_errored"] } }, "required": ["type"] },
              "then": { "required": ["testId"] }
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "testId": { "type": "string", "pattern": "^[A-Za-z0-9._:/@+-]{1,512}$" },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "origin"],
      "properties": {
        "id": { "$ref": "#/$defs/testId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "group": { "type": "string", "maxLength": 512 },
        "origin": { "enum": ["student", "provided", "external"] },
        "location": { "type": "object", "additionalProperties": false, "required": ["path", "line"], "properties": { "path": { "$ref": "#/$defs/path" }, "line": { "type": "integer", "minimum": 1 }, "column": { "type": "integer", "minimum": 1 } } }
      }
    },
    "path": { "type": "string", "minLength": 2, "maxLength": 1024, "pattern": "^/workspace(?:/(?!\\.{1,2}(?:/|$))[^/\\u0000\\uD800-\\uDFFF\\\\]+)+$" }
  }
}
